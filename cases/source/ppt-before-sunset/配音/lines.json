[
 {"id":"n01","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"当代边境，一座荒原小镇。退役搜救员陆川，话少，习惯替所有人做决定。"},
 {"id":"n02","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"女儿陆遥十九岁，正在拍一部关于边境野生动物的作业。"},
 {"id":"y01","who":"陆遥","voice":"Chinese (Mandarin)_Crisp_Girl","emotion":"fearful","zh":"爸……别挂。我拍到了他们装车，他们把我——"},
 {"id":"g01","who":"看守","voice":"Spanish_AngryMan","lang":"Spanish","emotion":"angry","say":"¡Dame el teléfono!","zh":"给我手机！","es":"¡Dame el teléfono!"},
 {"id":"c01","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.95,"zh":"遥遥？你在哪儿？"},
 {"id":"y02","who":"陆遥","voice":"Chinese (Mandarin)_Crisp_Girl","emotion":"fearful","zh":"北边，旧矿——"},
 {"id":"n03","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"通话断了。最后传来的，是一句他听不懂的外语。"},
 {"id":"n04","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"下午四点十分，离日落还有三个半小时。他戴上女儿送的太阳镜，一个人，冲进荒原。"},
 {"id":"n05","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"岔路口的牧场主见过那辆车，可他只会说西班牙语。"},
 {"id":"c02","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.95,"zh":"帮我翻译西班牙语。"},
 {"id":"e01","who":"埃斯特班","voice":"Spanish_Jovialman","lang":"Spanish","say":"Se la llevaron en un camión gris. Le rompieron la cámara.","zh":"她上了那辆灰色卡车。他们把她的相机摔坏了。","es":"Se la llevaron en un camión gris. Le rompieron la cámara."},
 {"id":"t01","who":"翻译","voice":"Chinese (Mandarin)_News_Anchor","speed":1.08,"zh":"她上了那辆灰色卡车。他们把她的相机摔坏了。"},
 {"id":"e02","who":"埃斯特班","voice":"Spanish_Jovialman","lang":"Spanish","say":"Entran por el este. Hay un tanque de agua rojo.","zh":"他们从东边进，那里有个红色水罐。","es":"Entran por el este. Hay un tanque de agua rojo."},
 {"id":"t02","who":"翻译","voice":"Chinese (Mandarin)_News_Anchor","speed":1.08,"zh":"他们从东边进，那里有个红色水罐。"},
 {"id":"e03","who":"埃斯特班","voice":"Spanish_Jovialman","lang":"Spanish","say":"Atrás hay un camino del agua. Yo trabajaba allí.","zh":"后面还有一条运水的路，我以前在那儿干活。","es":"Atrás hay un camino del agua. Yo trabajaba allí."},
 {"id":"t03","who":"翻译","voice":"Chinese (Mandarin)_News_Anchor","speed":1.08,"zh":"后面还有一条运水的路，我以前在那儿干活。"},
 {"id":"n06","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"听懂一句话，就多找到一条路。"},
 {"id":"b01","who":"头目","voice":"Spanish_Deep-tonedMan","lang":"Spanish","speed":0.95,"say":"Llévensela. Cruzamos el paso antes del anochecer.","zh":"把她带走。天黑前过山口。","es":"Llévensela. Cruzamos el paso antes del anochecer."},
 {"id":"n07","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"天黑之前，绑匪就要转移。他伏在山坡上锁定矿场，再沿着运水便道摸下去。"},
 {"id":"n08","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"从烈日走进暗处，镜片跟着光线，一点点变浅。"},
 {"id":"c03","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.9,"zh":"遥遥。"},
 {"id":"y03","who":"陆遥","voice":"Chinese (Mandarin)_Crisp_Girl","emotion":"sad","zh":"爸……"},
 {"id":"n09","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"父女终于重逢，出口却已经被堵死。"},
 {"id":"c04","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.95,"zh":"我托你上去——"},
 {"id":"y04","who":"陆遥","voice":"Chinese (Mandarin)_Crisp_Girl","zh":"爸，听我一次。钥匙在车上，侧门外的木栏，已经烂了。"},
 {"id":"c05","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.95,"zh":"……上车。"},
 {"id":"c06","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":1.0,"emotion":"angry","zh":"坐稳！"},
 {"id":"n10","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"这一次，他没有一个人扛。他们一起闯了出去。"},
 {"id":"c07","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.9,"zh":"疼不疼？"},
 {"id":"y05","who":"陆遥","voice":"Chinese (Mandarin)_Crisp_Girl","emotion":"sad","zh":"疼。"},
 {"id":"n11","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"公路边的便利店。他一手扶着女儿，一手按着伤口。"},
 {"id":"k01","who":"店员","voice":"Chinese (Mandarin)_Kind-hearted_Antie","zh":"十块。"},
 {"id":"c08","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.95,"zh":"帮我付一下。"},
 {"id":"t04","who":"眼镜","voice":"Chinese (Mandarin)_News_Anchor","speed":1.08,"zh":"支付成功。"},
 {"id":"y06","who":"陆遥","voice":"Chinese (Mandarin)_Crisp_Girl","emotion":"happy","zh":"牛仔也用高科技？"},
 {"id":"c09","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.92,"zh":"牛仔也得有人帮。"},
 {"id":"y07","who":"陆遥","voice":"Chinese (Mandarin)_Crisp_Girl","zh":"胶带还没撕啊？"},
 {"id":"c10","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.92,"zh":"你说贴着好认。"},
 {"id":"n12","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.95,"zh":"接听求救，听懂问路，腾不出手的时候，替他付款。"},
 {"id":"n13","who":"旁白","voice":"Chinese (Mandarin)_Radio_Host","speed":0.92,"zh":"救她，也学会被救。"},
 {"id":"y08","who":"陆遥","voice":"Chinese (Mandarin)_Crisp_Girl","zh":"爸，面里别放香菜。"},
 {"id":"c11","who":"陆川","voice":"Chinese (Mandarin)_Reliable_Executive","pitch":-2,"speed":0.95,"zh":"记着呢。"}
]

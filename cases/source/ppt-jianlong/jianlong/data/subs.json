[
 {
  "id": "n01_0",
  "seg": "S01",
  "vo": "n01",
  "t0": 4.539,
  "speak_end": 7.836,
  "text": "一座村庄，一副眼镜，一段历史",
  "style": "present",
  "t1": 8.436
 },
 {
  "id": "n02_0",
  "seg": "S02",
  "vo": "n02",
  "t0": 10.039,
  "speak_end": 10.776,
  "text": "暴雨初歇",
  "style": "present",
  "t1": 10.726
 },
 {
  "id": "n02_1",
  "seg": "S02",
  "vo": "n02",
  "t0": 10.776,
  "speak_end": 14.189,
  "text": "调查员阿山随队连夜抵达一座空村",
  "style": "present",
  "t1": 14.701
 },
 {
  "id": "n02_2",
  "seg": "S02",
  "vo": "n02",
  "t0": 14.751,
  "speak_end": 17.776,
  "text": "全村漆黑，只剩一扇窗还亮着",
  "style": "present",
  "t1": 18.376
 },
 {
  "id": "n03_0",
  "seg": "S03",
  "vo": "n03",
  "t0": 21.039,
  "speak_end": 24.128,
  "text": "窗里坐着守村的老人。车灯扫过窗纸",
  "style": "present",
  "t1": 24.078
 },
 {
  "id": "n03_1",
  "seg": "S03",
  "vo": "n03",
  "t0": 24.128,
  "speak_end": 27.231,
  "text": "他头也不抬，只低声哼着一支老调",
  "style": "present",
  "t1": 27.831
 },
 {
  "id": "n04_0",
  "seg": "S04",
  "vo": "n04",
  "t0": 35.383,
  "speak_end": 36.934,
  "text": "老人忽然抓住阿山的胳膊",
  "style": "present",
  "t1": 36.884
 },
 {
  "id": "n04_1",
  "seg": "S04",
  "vo": "n04",
  "t0": 36.934,
  "speak_end": 40.593,
  "text": "异常激动，只说了一句：要记住",
  "style": "present",
  "t1": 41.193
 },
 {
  "id": "n05_0",
  "seg": "S05",
  "vo": "n05",
  "t0": 43.039,
  "speak_end": 45.754,
  "text": "雨夜檐下，眼镜回放老人的歌声",
  "style": "present",
  "t1": 45.704
 },
 {
  "id": "n05_1",
  "seg": "S05",
  "vo": "n05",
  "t0": 45.754,
  "speak_end": 47.965,
  "text": "把歌词和山形一一比对",
  "style": "present",
  "t1": 48.565
 },
 {
  "id": "n05_2",
  "seg": "S05",
  "vo": "n05",
  "t0": 48.726,
  "speak_end": 50.432,
  "text": "浮现出一头青色的鹿影",
  "style": "present",
  "t1": 51.032
 },
 {
  "id": "n06_0",
  "seg": "S06",
  "vo": "n06",
  "t0": 52.537,
  "speak_end": 54.229,
  "text": "第二天，鹿角奇石",
  "style": "present",
  "t1": 54.179
 },
 {
  "id": "n06_1",
  "seg": "S06",
  "vo": "n06",
  "t0": 54.229,
  "speak_end": 57.061,
  "text": "三块虎掌印石，都在山里找到了",
  "style": "present",
  "t1": 57.605
 },
 {
  "id": "n06_2",
  "seg": "S06",
  "vo": "n06",
  "t0": 57.655,
  "speak_end": 60.561,
  "text": "口诀一句句应验，传说一件件落了地",
  "style": "present",
  "t1": 61.161
 },
 {
  "id": "n07_0",
  "seg": "S07",
  "vo": "n07",
  "t0": 62.039,
  "speak_end": 64.172,
  "text": "暴雨再起，队伍连夜撤离",
  "style": "present",
  "t1": 64.122
 },
 {
  "id": "n07_1",
  "seg": "S07",
  "vo": "n07",
  "t0": 64.172,
  "speak_end": 66.112,
  "text": "泥石流截断了归路",
  "style": "present",
  "t1": 66.701
 },
 {
  "id": "n07_2",
  "seg": "S07",
  "vo": "n07",
  "t0": 66.751,
  "speak_end": 69.078,
  "text": "进退之间，只剩上山一条路",
  "style": "present",
  "t1": 69.678
 },
 {
  "id": "n08_0",
  "seg": "S08",
  "vo": "n08",
  "t0": 70.537,
  "speak_end": 74.338,
  "text": "老人的歌成了地图：项横生，眼朝东",
  "style": "present",
  "t1": 74.938
 },
 {
  "id": "n09_0",
  "seg": "S09",
  "vo": "n09",
  "t0": 75.539,
  "speak_end": 79.107,
  "text": "走到一大块白石前，一路昏沉的老人醒了",
  "style": "present",
  "t1": 79.667
 },
 {
  "id": "n09_1",
  "seg": "S09",
  "vo": "n09",
  "t0": 79.717,
  "speak_end": 83.013,
  "text": "他凭着肌肉记忆，指着白石低声吟唱",
  "style": "present",
  "t1": 83.613
 },
 {
  "id": "n10_0",
  "seg": "S11",
  "vo": "n10",
  "t0": 89.539,
  "speak_end": 91.284,
  "text": "心跳，来自白石",
  "style": "present",
  "t1": 91.762
 },
 {
  "id": "n10_1",
  "seg": "S11",
  "vo": "n10",
  "t0": 91.812,
  "speak_end": 95.42,
  "text": "六百年的旧物凌空归位，口诀一字字亮起",
  "style": "present",
  "t1": 95.859
 },
 {
  "id": "n10_2",
  "seg": "S11",
  "vo": "n10",
  "t0": 95.909,
  "speak_end": 98.314,
  "text": "每一个部件，都是村里的一段往事",
  "style": "present",
  "t1": 98.914
 },
 {
  "id": "n11_0",
  "seg": "S12",
  "vo": "n11",
  "t0": 102.539,
  "speak_end": 107.13,
  "text": "角，救命田。那年大荒，村长开仓分粮",
  "style": "flash",
  "t1": 107.08
 },
 {
  "id": "n11_1",
  "seg": "S12",
  "vo": "n11",
  "t0": 107.13,
  "speak_end": 109.923,
  "text": "鹿角岩俯身守着最后一块田",
  "style": "flash",
  "t1": 109.873
 },
 {
  "id": "n11_2",
  "seg": "S12",
  "vo": "n11",
  "t0": 109.923,
  "speak_end": 112.095,
  "text": "全村靠它活了下来",
  "style": "flash",
  "t1": 112.695
 },
 {
  "id": "n12_0",
  "seg": "S13",
  "vo": "n12",
  "t0": 115.539,
  "speak_end": 119.424,
  "text": "爪，退豪绅。豪绅带人进山抢地",
  "style": "flash",
  "t1": 119.374
 },
 {
  "id": "n12_1",
  "seg": "S13",
  "vo": "n12",
  "t0": 119.424,
  "speak_end": 121.751,
  "text": "却见三块巨石刻着掌印",
  "style": "flash",
  "t1": 121.701
 },
 {
  "id": "n12_2",
  "seg": "S13",
  "vo": "n12",
  "t0": 121.751,
  "speak_end": 124.117,
  "text": "不战而退，再没敢来",
  "style": "flash",
  "t1": 124.5
 },
 {
  "id": "n13_0",
  "seg": "S14",
  "vo": "n13",
  "t0": 126.537,
  "speak_end": 129.744,
  "text": "眼，守望灯台。崖顶圆潭如龙眼",
  "style": "flash",
  "t1": 129.694
 },
 {
  "id": "n13_1",
  "seg": "S14",
  "vo": "n13",
  "t0": 129.744,
  "speak_end": 133.827,
  "text": "守夜人挂灯，四百年接力，不曾断过",
  "style": "flash",
  "t1": 134.234
 },
 {
  "id": "n13_2",
  "seg": "S14",
  "vo": "n13",
  "t0": 134.284,
  "speak_end": 136.381,
  "text": "山洪来了，总有人先看见",
  "style": "flash",
  "t1": 136.331
 },
 {
  "id": "n13_3",
  "seg": "S14",
  "vo": "n13",
  "t0": 136.381,
  "speak_end": 138.109,
  "text": "没淹死过一个人",
  "style": "flash",
  "t1": 138.709
 },
 {
  "id": "n14_0",
  "seg": "S15",
  "vo": "n14",
  "t0": 141.039,
  "speak_end": 142.781,
  "text": "脊，接力山路",
  "style": "flash",
  "t1": 143.381
 },
 {
  "id": "n14_1",
  "seg": "S15",
  "vo": "n14",
  "t0": 143.485,
  "speak_end": 146.355,
  "text": "梯田和之字石路，祖孙几代一锤一锤",
  "style": "flash",
  "t1": 146.305
 },
 {
  "id": "n14_2",
  "seg": "S15",
  "vo": "n14",
  "t0": 146.355,
  "speak_end": 149.07,
  "text": "凿了四百年，铺成了龙脊",
  "style": "flash",
  "t1": 149.67
 },
 {
  "id": "n15_0",
  "seg": "S16",
  "vo": "n15",
  "t0": 154.039,
  "speak_end": 158.815,
  "text": "鳞，褪鳞成薪。龙褪下的鳞，是满山落叶",
  "style": "flash",
  "t1": 158.765
 },
 {
  "id": "n15_1",
  "seg": "S16",
  "vo": "n15",
  "t0": 158.815,
  "speak_end": 162.655,
  "text": "码成柴垛，就成了全村过冬的体温",
  "style": "flash",
  "t1": 163.255
 },
 {
  "id": "n16_0",
  "seg": "S17",
  "vo": "n16",
  "t0": 166.039,
  "speak_end": 167.859,
  "text": "心，白石立约",
  "style": "flash",
  "t1": 168.459
 },
 {
  "id": "n16_1",
  "seg": "S17",
  "vo": "n16",
  "t0": 168.52,
  "speak_end": 170.42,
  "text": "村民在白石上立下一纸村规",
  "style": "flash",
  "t1": 170.37
 },
 {
  "id": "n16_2",
  "seg": "S17",
  "vo": "n16",
  "t0": 170.42,
  "speak_end": 174.287,
  "text": "约立起的那一刻，龙，就有了心",
  "style": "flash",
  "t1": 174.887
 },
 {
  "id": "n17_0",
  "seg": "S18",
  "vo": "n17",
  "t0": 177.939,
  "speak_end": 182.287,
  "text": "原来，山脊就是龙背，梯田就是鳞甲",
  "style": "present",
  "t1": 182.887
 },
 {
  "id": "n17_1",
  "seg": "S18",
  "vo": "n17",
  "t0": 182.969,
  "speak_end": 185.956,
  "text": "世事变迁，我一直走在它的身上",
  "style": "present",
  "t1": 186.556
 },
 {
  "id": "n18_0",
  "seg": "S19",
  "vo": "n18",
  "t0": 189.039,
  "speak_end": 190.978,
  "text": "一部眼镜，看透六百年",
  "style": "present",
  "t1": 191.578
 }
]
[
  {"id":"d01","start":18.0,"end":22.0,"speaker":"老周","text":"末班船。靠岸后收船。","file":"audio/dialogue/d01.wav"},
  {"id":"d02","start":27.0,"end":30.0,"speaker":"林潮","text":"乘客下完了。","file":"audio/dialogue/d02.wav"},
  {"id":"d03","start":39.0,"end":45.5,"speaker":"乐奇","text":"远洋聘书，回复截止：明早六点。","file":"audio/dialogue/d03.wav"},
  {"id":"d04","start":49.0,"end":51.5,"speaker":"林潮","text":"晚点再说。","file":"audio/dialogue/d04.wav"},
  {"id":"d05","start":82.0,"end":84.8,"speaker":"林潮","text":"乐奇，看看它。","file":"audio/dialogue/d05.wav"},
  {"id":"d06","start":86.5,"end":89.0,"speaker":"乐奇","text":"未能识别。","file":"audio/dialogue/d06.wav"},
  {"id":"d07","start":92.0,"end":97.0,"speaker":"林潮","text":"乐奇，什么鱼会在天上游？","file":"audio/dialogue/d07.wav"},
  {"id":"d08","start":100.0,"end":105.0,"speaker":"乐奇","text":"庄子说：北冥有鱼，其名为鲲。","file":"audio/dialogue/d08.wav"},
  {"id":"d09","start":107.0,"end":112.0,"speaker":"乐奇","text":"海运，则将徙于南冥。","file":"audio/dialogue/d09.wav"},
  {"id":"d10","start":114.0,"end":119.0,"speaker":"乐奇","text":"要有海，也要有托起翅膀的风。","file":"audio/dialogue/d10.wav"},
  {"id":"d11","start":128.0,"end":133.0,"speaker":"林潮","text":"老周，天上有东西。","file":"audio/dialogue/d11.wav"},
  {"id":"d12","start":138.0,"end":141.5,"speaker":"老周","text":"江上只有雾。","file":"audio/dialogue/d12.wav"},
  {"id":"d13","start":144.0,"end":147.0,"speaker":"老周","text":"回码头。","file":"audio/dialogue/d13.wav"},
  {"id":"d14","start":157.0,"end":160.5,"speaker":"林潮","text":"它一直在兜圈子。","file":"audio/dialogue/d14.wav"},
  {"id":"d15","start":174.0,"end":178.5,"speaker":"林潮","text":"乐奇，导航到吴淞口。","file":"audio/dialogue/d15.wav"},
  {"id":"d16","start":181.0,"end":185.0,"speaker":"乐奇","text":"终点，吴淞口。","file":"audio/dialogue/d16.wav"},
  {"id":"d17","start":191.0,"end":194.0,"speaker":"林潮","text":"跟我走。","file":"audio/dialogue/d17.wav"},
  {"id":"d18","start":232.0,"end":235.0,"speaker":"林潮","text":"它听见了。","file":"audio/dialogue/d18.wav"},
  {"id":"d19","start":257.0,"end":260.5,"speaker":"林潮","text":"海在这边。","file":"audio/dialogue/d19.wav"},
  {"id":"d20","start":269.0,"end":272.0,"speaker":"林潮","text":"别回去。","file":"audio/dialogue/d20.wav"},
  {"id":"d21","start":282.0,"end":285.5,"speaker":"老周","text":"林潮，你在哪？","file":"audio/dialogue/d21.wav"},
  {"id":"d22","start":287.5,"end":290.0,"speaker":"林潮","text":"吴淞口。","file":"audio/dialogue/d22.wav"},
  {"id":"d23","start":300.0,"end":305.0,"speaker":"老周","text":"日志上，我记你避雾。","file":"audio/dialogue/d23.wav"},
  {"id":"d24","start":308.0,"end":312.5,"speaker":"老周","text":"油够你开到灯塔。","file":"audio/dialogue/d24.wav"},
  {"id":"d25","start":314.0,"end":319.5,"speaker":"乐奇","text":"距回复截止，还有一小时十二分。","file":"audio/dialogue/d25.wav"},
  {"id":"d26","start":338.0,"end":341.5,"speaker":"林潮","text":"它不是迷路了。","file":"audio/dialogue/d26.wav"},
  {"id":"d27","start":346.0,"end":352.0,"speaker":"林潮","text":"它是太久没见过真的海了。","file":"audio/dialogue/d27.wav"},
  {"id":"d28","start":365.0,"end":368.5,"speaker":"林潮","text":"探照灯，关掉。","file":"audio/dialogue/d28.wav"},
  {"id":"d29","start":376.0,"end":379.5,"speaker":"林潮","text":"航行灯留着。","file":"audio/dialogue/d29.wav"},
  {"id":"d30","start":408.0,"end":411.0,"speaker":"林潮","text":"天亮了。","file":"audio/dialogue/d30.wav"},
  {"id":"d31","start":444.0,"end":447.0,"speaker":"林潮","text":"风起来了。","file":"audio/dialogue/d31.wav"},
  {"id":"d32","start":495.0,"end":499.0,"speaker":"乐奇","text":"距回复截止，还有四分钟。","file":"audio/dialogue/d32.wav"},
  {"id":"d33","start":502.0,"end":507.5,"speaker":"林潮","text":"乐奇，回复远洋公司的邮件。","file":"audio/dialogue/d33.wav"},
  {"id":"d34","start":510.0,"end":512.8,"speaker":"林潮","text":"我接受。","file":"audio/dialogue/d34.wav"},
  {"id":"d35","start":516.0,"end":518.5,"speaker":"乐奇","text":"已发送。","file":"audio/dialogue/d35.wav"}
]

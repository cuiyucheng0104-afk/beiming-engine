{
  "permissions": {
    "deny": [
      "Edit(/cases/vendor/**)",
      "Edit(/cases/source/**)",
      "Read(~/lemo-opuscar/**)",
      "Read(~/lemo-my-styles/**)",
      "Edit(~/lemo-opuscar/**)",
      "Edit(~/lemo-my-styles/**)",
      "Skill(lemo-opuscar)",
      "Skill(lemo-opuscar:*)",
      "Skill(sy-style-100)",
      "Skill(sy-style-100:*)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add * -A)",
      "Bash(git add * -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add * --all)",
      "Bash(git add * --all *)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add -- .)",
      "Bash(git stage -A)",
      "Bash(git stage -A *)",
      "Bash(git stage * -A)",
      "Bash(git stage * -A *)",
      "Bash(git stage --all)",
      "Bash(git stage --all *)",
      "Bash(git stage * --all)",
      "Bash(git stage * --all *)",
      "Bash(git stage .)",
      "Bash(git stage . *)",
      "Bash(git stage -- .)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "PowerShell(git add -A)",
      "PowerShell(git add -A *)",
      "PowerShell(git add * -A)",
      "PowerShell(git add * -A *)",
      "PowerShell(git add --all)",
      "PowerShell(git add --all *)",
      "PowerShell(git add * --all)",
      "PowerShell(git add * --all *)",
      "PowerShell(git add .)",
      "PowerShell(git add . *)",
      "PowerShell(git add -- .)",
      "PowerShell(git stage -A)",
      "PowerShell(git stage -A *)",
      "PowerShell(git stage * -A)",
      "PowerShell(git stage * -A *)",
      "PowerShell(git stage --all)",
      "PowerShell(git stage --all *)",
      "PowerShell(git stage * --all)",
      "PowerShell(git stage * --all *)",
      "PowerShell(git stage .)",
      "PowerShell(git stage . *)",
      "PowerShell(git stage -- .)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Skill|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 15,
            "if": "Read(/cases/**)"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 15,
            "if": "Read(/out/casebook/**)"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lemo-opuscar@lemolab": false
  },
  "claudeMdExcludes": [
    "**/cases/vendor/**",
    "**/cases/source/**",
    "**/out/casebook/**"
  ]
}

      "sha256": "32a5dd81a5b82aed967c2d36e6e1542102c54ecbbefb59bbc1e496fa11182504"
    },
    {
      "key": "audio/vo_V05.ogg",
      "id": "V05",
      "act": "A05",
      "at": 127.5,
      "text": "三万动态节点同帧共振，掀起算力海啸。",
      "kind": "audio_vo_ai",
      "file": "opus/vo_V05.ogg",
      "mime": "audio/ogg",
      "dur_s": 4.083,
      "bytes": 14825,

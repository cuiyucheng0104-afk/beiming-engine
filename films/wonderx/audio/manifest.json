    },
    {
      "key": "audio/vo_V04.ogg",
      "id": "V04",
      "act": "A04",
      "at": 106.5,
      "text": "物理光谱与焦散，把抽象卖点拍成大片。",
      "kind": "audio_vo_ai",
      "file": "opus/vo_V04.ogg",
      "mime": "audio/ogg",
      "dur_s": 3.024,
      "bytes": 11175,

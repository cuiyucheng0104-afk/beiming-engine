    },
    {
      "key": "audio/vo_V06.ogg",
      "id": "V06",
      "act": "A06",
      "at": 163.5,
      "text": "一镜到底，穿越宏观地形与微观芯片。",
      "kind": "audio_vo_ai",
      "file": "opus/vo_V06.ogg",
      "mime": "audio/ogg",
      "dur_s": 3.704,
      "bytes": 13416,

    },
    {
      "key": "audio/vo_V03.ogg",
      "id": "V03",
      "act": "A03",
      "at": 72.5,
      "text": "六层同轴精密拆解，一秒看穿黑盒架构。",
      "kind": "audio_vo_ai",
      "file": "opus/vo_V03.ogg",
      "mime": "audio/ogg",

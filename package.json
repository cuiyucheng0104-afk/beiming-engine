{
  "name": "beiming-engine",
  "version": "1.0.0",
  "description": "北冥引擎：代码即影片的三渲二 + 2.5D 风格化渲染管线",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/film/beiming.mjs",
    "stills": "node engine/render/still.mjs . --range 0:9.5:0.5 --out out/stills",
    "video": "node engine/render/video.mjs . --out out/video.mp4",
    "video:4k": "node engine/render/video.mjs . --size 3840x2080 --workers 8 --out out/video_4k.mp4",
    "setup": "node tools/env/setup.mjs",
    "raea:prepare": "node engine/native/prepare.mjs examples/raea",
    "raea:check": "node engine/render/native.mjs examples/raea --check-only",
    "raea:render": "node engine/render/native.mjs examples/raea",
    "routes:check": "node tools/work-plan.mjs --check",
    "routes:next": "node tools/work-plan.mjs --ready",
    "test": "node tools/run-tests.mjs",
    "test:routes": "node tools/run-tests.mjs --only ci,production,tools",
    "test:engine": "node tools/run-tests.mjs --only engine,lab",
    "test:audio": "node tools/run-tests.mjs --only audio",
    "cases:check": "node tools/env/py.mjs tools/casebook.py check",
    "cases:list": "node tools/env/py.mjs tools/casebook.py list",
    "test:cases": "node tools/run-tests.mjs --only tools",
    "site:build": "node tools/env/py.mjs tools/build-showcase.py",
    "site:serve": "node engine/render/serve.mjs --root out/site --port 8090",
    "site:qa": "node tools/site-qa.mjs",
    "native:prepare": "node engine/native/prepare.mjs",
    "native:check": "node engine/render/native.mjs --check-only",
    "native:render": "node engine/render/native.mjs",
    "native:bridge": "node engine/native/bridge/export.mjs",
    "native:sequence": "node engine/native/sequence.mjs",
    "new": "node tools/new-film.mjs",
    "check:repo": "node tools/repo-check.mjs",
    "c:styles": "node tools/c-styles.mjs",
    "c:styles:check": "node tools/c-styles.mjs --check",
    "c:events": "node engine/render/events.mjs",
    "c:build": "node engine/render/build.mjs",
    "check": "node tools/check-all.mjs",
    "lint": "node tools/check-all.mjs --only lint",
    "changelog:check": "node tests/ci/changelog.mjs check",
    "ci:smoke": "node tests/ci/smoke-render.mjs",
    "ci:paths": "node tests/ci/windows-paths.mjs",
    "plan:check": "node tools/work-plan.mjs --check",
    "plan:next": "node tools/work-plan.mjs --ready",
    "env:doctor": "node tools/env/doctor.mjs",
    "env:preflight": "node tools/env/preflight.mjs",
    "env:py": "node tools/env/py.mjs",
    "env:lock": "node tools/env/lock.mjs",
    "env:large-files": "node tools/env/large-files.mjs",
    "remote": "node tools/remote/cli.mjs",
    "test:env": "node --test \"tests/env/*.test.mjs\"",
    "qa": "node tools/qa/cli.mjs",
    "test:qa": "node --test \"tests/qa/*.test.mjs\"",
    "comp:scan": "node tools/compliance/scan.mjs",
    "comp:rights": "node tools/compliance/rights-inventory.mjs --check",
    "comp:signed-urls": "node tools/compliance/signed-urls.mjs list",
    "comp:aigc": "node tools/compliance/aigc.mjs",
    "test:comp": "node --test \"tests/comp/*.test.mjs\"",
    "eval:bank": "node tools/eval/run.mjs bank",
    "eval:prepare": "node tools/eval/run.mjs prepare",
    "eval:drive": "node tools/eval/run.mjs drive",
    "eval:reply": "node tools/eval/run.mjs reply",
    "eval:finish": "node tools/eval/run.mjs finish",
    "eval:status": "node tools/eval/run.mjs status",
    "eval:clean": "node tools/eval/run.mjs clean",
    "eval:gates": "node tools/eval/gates.mjs",
    "eval:score": "node tools/eval/score.mjs run",
    "eval:summary": "node tools/eval/score.mjs summary",
    "eval:selftest": "node tools/eval/score.mjs --self-test",
    "test:eval": "node --test \"tests/eval/*.test.mjs\"",
    "film": "node tools/film/cli.mjs",
    "beiming:build": "node tools/film/beiming.mjs",
    "test:film": "node tools/run-tests.mjs --only film",
    "serve": "node engine/render/serve.mjs",
    "env:gpu": "node tools/rtx/gpucheck.mjs",
    "golden": "node tools/baseline/golden.mjs",
    "determinism": "node tools/baseline/determinism.mjs",
    "audio:build": "node tools/audio/build.mjs",
    "audio:qa": "node tools/audio/qa.mjs",
    "audio:cuecheck": "node tools/audio/cuecheck.mjs",
    "audio:voice": "node tools/audio/voice.mjs",
    "audio:samples": "node tools/audio/fetch-samples.mjs",
    "fonts:fetch": "node tools/fonts/fetch.mjs",
    "fonts:subset": "node tools/fonts/subset.mjs",
    "plates:check": "node tools/plates/check.mjs",
    "plates:bleed": "node tools/plates/bleed.mjs",
    "lookdev:sweep": "node tools/lookdev/sweep.mjs",
    "test:style": "node tools/run-tests.mjs --only style",
    "b:preflight": "node engine/render/native.mjs --check-only",
    "b:render": "node engine/render/native.mjs",
    "b:prepare": "node engine/native/prepare.mjs",
    "b:runtime": "node engine/native/runtime.mjs",
    "test:native": "node tools/run-tests.mjs --only native",
    "c:setup": "node tools/c-runtime.mjs setup",
    "c:runtime": "node tools/c-runtime.mjs",
    "c:fonts:check": "node routes/c-style/fonts/fetch.mjs --check",
    "cases:restore": "node tools/env/py.mjs tools/casebook.py restore",
    "cases:index": "node tools/env/py.mjs tools/casebook.py index",
    "cases:rights": "node tools/env/py.mjs tools/casebook.py rights --check"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "playwright-core": "1.63.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}

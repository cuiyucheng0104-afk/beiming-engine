{
  "name": "beiming-engine",
  "version": "1.0.0",
  "description": "北冥引擎：代码即影片的三渲二 + 2.5D 风格化渲染管线",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "sh build.sh",
    "stills": "node engine/render/still.mjs . --range 0:9.5:0.5 --out out/stills",
    "video": "node engine/render/video.mjs . --out out/video.mp4",
    "video:4k": "node engine/render/video.mjs . --size 3840x2080 --workers 8 --out out/video_4k.mp4",
    "setup": "npm install && npx playwright-core install chromium-headless-shell",
    "raea:prepare": "node examples/raea/tools/prepare.mjs",
    "raea:check": "node examples/raea/tools/render.mjs --check-only",
    "raea:render": "node examples/raea/tools/render.mjs",
    "routes:check": "node tools/work-plan.mjs --check",
    "routes:next": "node tools/work-plan.mjs --ready",
    "test": "npm run routes:check && npm run test:routes && npm run test:engine && npm run test:cases && npm run cases:check",
    "test:routes": "cd tests && node --test && node --test ../tools/work-plan.test.mjs",
    "test:engine": "node --test \"engine/**/*.test.mjs\" lab/regress.test.mjs",
    "test:audio": "python3 -m unittest discover -s engine/audio -t . -p \"test_*.py\" && python3 -m unittest discover -s audio -p \"test_*.py\"",
    "cases:check": "python3 tools/casebook.py check",
    "cases:list": "python3 tools/casebook.py list",
    "test:cases": "python3 -m unittest discover -s tools -p test_casebook.py",
    "site:build": "python3 tools/build-showcase.py",
    "site:serve": "python3 -m http.server 8090 -d out/site",
    "site:qa": "node tools/site-qa.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "playwright-core": "1.63.0",
    "three": "0.170.0"
  }
}

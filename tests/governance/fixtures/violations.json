{
  "about": "仓库规范检查（tools/repo-check.mjs）core 规则的违规夹具：tests/governance/repo-check.test.mjs 先按真实的 routes/routes.json 在临时目录里搭一个全部合格的小仓库，再按下面每条改动造出一种违规，断言 --only <规则> 报出该规则 id 的错误并退出 4。改动写法：write 覆盖或新建文件；append 在文件末尾追加；appendRepeat 把一段文字重复追加 n 次；replace 在文件里替换文字；remove 删除文件或目录；patch 改 JSON 文件里的一个值（路径用点分，数组用下标）；git 为 true 时先 git init 并提交全部文件。小仓库里的 AGENTS.md、CLAUDE.md 只在测试时生成，不入库（入库的嵌套指令文件会被 agent 当成真指令）。",
  "cases": [
    { "rule": "core.registry", "title": "注册表的品牌名带 RTX", "patch": { "routes/routes.json": [["routes.1.brand", "北冥原生 · BNE · RTX 工具链"]] }, "expect": "RTX" },
    { "rule": "core.registry", "title": "注册表里两条路线 id 重复", "patch": { "routes/routes.json": [["routes.2.id", "a"]] }, "expect": "重复" },
    { "rule": "core.route-ids", "title": "作品 film.json 用旧路线名", "write": { "films/old/film.json": "{ \"route\": \"beiming\", \"title\": \"旧\", \"dur\": 3, \"fps\": 24, \"size\": [1920, 1080] }\n" }, "expect": "不是注册表 id" },
    { "rule": "core.manuals", "title": "手册缺一节", "replace": { "routes/b-native/README.md": [["## 契约\n", "## 约定\n"]] }, "expect": "缺少二级标题" },
    { "rule": "core.templates", "title": "模版里有不认识的占位符", "append": { "routes/c-style/template/README.md": "\n作者：{{AUTHOR}}\n" }, "expect": "{{AUTHOR}}" },
    { "rule": "core.templates", "title": "模版 film.json 的 title 不是占位符", "patch": { "routes/a-webgl/template/film.json": [["title", "写死的片名"]] }, "expect": "title 应为" },
    { "rule": "core.links", "title": "总指引里有失效的相对链接", "append": { "routes/README.md": "\n见 [不存在的文档](no-such.md)。\n" }, "expect": "no-such.md" },
    { "rule": "core.links", "title": "锚点对不上标题", "append": { "routes/README.md": "\n见 [手册的验收](a-webgl/README.md#没有这一节)。\n" }, "expect": "锚点" },
    { "rule": "core.terms", "title": "入口文档说「两条路线」", "append": { "AGENTS.md": "\n本仓库有两条路线。\n" }, "expect": "两条路线" },
    { "rule": "core.terms", "title": "还在用「历史代号」", "append": { "routes/README.md": "\n目录沿用历史代号。\n" }, "expect": "历史代号" },
    { "rule": "core.terms", "title": "选路线的标题出现在总指引之外", "append": { "routes/a-webgl/README.md": "\n## 路线怎么选\n\n见总指引。\n" }, "expect": "路线怎么选" },
    { "rule": "core.upstream-names", "title": "把上游项目名当路线名", "append": { "routes/README.md": "\nB 也叫 RAEA 原生路线。\n" }, "expect": "RAEA 原生路线" },
    { "rule": "core.upstream-names", "title": "新目录名带上游项目名", "write": { "routes/raea-extra/README.md": "# 额外\n" }, "expect": "目录名" },
    { "rule": "core.entry-budget", "title": "AGENTS.md 超过 150 行", "appendRepeat": { "AGENTS.md": ["填充行\n", 160] }, "expect": "超过入口预算" },
    { "rule": "core.reach", "title": "AGENTS.md 不链到总指引", "write": { "AGENTS.md": "# 入口\n\n先读 routes/README.md（没有写成链接）。\n" }, "expect": "到不了" },
    { "rule": "core.claude-bridge", "title": "CLAUDE.md 里另写规则", "write": { "CLAUDE.md": "@AGENTS.md\n另外：随便提交。\n" }, "expect": "只有一行" },
    { "rule": "core.claude-bridge", "title": "没有 CLAUDE.md", "remove": ["CLAUDE.md"], "expect": "没有 CLAUDE.md" },
    { "rule": "core.films", "title": "作品目录缺 film.json", "write": { "films/empty/README.md": "# 空\n" }, "expect": "缺 film.json" },
    { "rule": "core.films", "title": "作品里残留占位符", "write": { "films/half/film.json": "{ \"route\": \"a\", \"title\": \"半成品\", \"dur\": 3, \"fps\": 24, \"size\": [1920, 1080] }\n", "films/half/README.md": "# {{TITLE}}\n" }, "expect": "残留占位符" },
    { "rule": "core.films-media", "title": "作品目录里提交了成片", "write": { "films/x/film.json": "{ \"route\": \"a\", \"title\": \"x\", \"dur\": 3, \"fps\": 24, \"size\": [1920, 1080] }\n", "films/x/x.mp4": "不是真的视频\n" }, "git": true, "expect": "音视频" },
    { "rule": "core.ascii-paths", "title": "tools/ 下的文件名有中文", "write": { "tools/新建.mjs": "// 中文名的脚本\n" }, "expect": "非 ASCII" },
    { "rule": "core.engine-heads", "title": "engine/ 模块开头没有注释", "write": { "engine/core/bare.js": "export const x = 1;\n" }, "expect": "开头没有注释" },
    { "rule": "core.engine-heads", "title": "engine/ 模块的注释没有中文", "write": { "engine/core/english.js": "// does things\nexport const y = 2;\n" }, "expect": "没有中文" },
    { "rule": "core.scripts", "title": "脚本指向不存在的文件", "patch": { "package.json": [["scripts.ghost", "node tools/ghost.mjs"]] }, "expect": "tools/ghost.mjs" },
    { "rule": "core.scripts", "title": "脚本串联了不存在的脚本", "patch": { "package.json": [["scripts.all", "npm run new && npm run nope"]] }, "expect": "npm run nope" },
    { "rule": "core.doc-commands", "title": "文档里的新建命令照抄会失败", "append": { "routes/README.md": "\n```sh\nnpm run new -- b 我的片子\n```\n" }, "expect": "我的片子" },
    { "rule": "core.doc-commands", "title": "文档里的新建命令路线不在注册表", "append": { "routes/README.md": "\n```sh\nnpm run new -- d my-film\n```\n" }, "expect": "不在注册表里" },
    { "rule": "core.vendor-immutable", "title": "作品被放进第三方快照", "write": { "cases/vendor/lock.json": "{ \"repositories\": [{ \"name\": \"demo\", \"path\": \"vendor/demo\", \"files\": [{ \"path\": \"README.md\", \"size\": 7 }] }] }\n", "cases/vendor/demo/README.md": "# demo\n", "cases/vendor/demo/films/x/index.html": "<p>x</p>\n" }, "expect": "films/" },
    { "rule": "core.vendor-immutable", "title": "快照里多了锁文件没登记的文件", "write": { "cases/vendor/lock.json": "{ \"repositories\": [{ \"name\": \"demo\", \"path\": \"vendor/demo\", \"files\": [{ \"path\": \"README.md\", \"size\": 7 }] }] }\n", "cases/vendor/demo/README.md": "# demo\n", "cases/vendor/demo/extra.js": "1\n" }, "expect": "没登记" },
    { "rule": "core.waivers", "title": "豁免条目缺属主与原因", "write": { "tools/repo-check/core/waivers.json": "{ \"waivers\": [{ \"rule\": \"core.terms\", \"file\": \"AGENTS.md\" }] }\n" }, "only": "core", "expect": "缺字段" }
  ]
}

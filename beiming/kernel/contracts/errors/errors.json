{
  "format": "errors/0.1",
  "prefixes": [
    {
      "prefix": "usage.",
      "exitCode": 2,
      "meaning": "用法错误"
    },
    {
      "prefix": "env.",
      "exitCode": 3,
      "meaning": "环境或依赖缺失、不合格"
    },
    {
      "prefix": "contract.",
      "exitCode": 4,
      "meaning": "契约、验收或闸门不通过"
    },
    {
      "prefix": "busy.",
      "exitCode": 5,
      "meaning": "资源忙"
    },
    {
      "prefix": "timeout.",
      "exitCode": 124,
      "meaning": "超时"
    },
    {
      "prefix": "failure.",
      "exitCode": 1,
      "meaning": "运行失败"
    },
    {
      "prefix": "auth.",
      "exitCode": 4,
      "meaning": "没有权限做这次写入"
    }
  ],
  "codes": [
    {
      "code": "auth.base-readonly",
      "meaning": "服务器之外的一方写 predicates.base"
    },
    {
      "code": "busy.rev-conflict",
      "meaning": "写入带的修订号和服务器当前的修订号不同"
    },
    {
      "code": "contract.bad-path",
      "meaning": "写入路径不合片子描述契约 5.4"
    },
    {
      "code": "contract.bad-value",
      "meaning": "写进去之后片子描述不合片子描述契约：过不了结构定义，或违反了没有专用码的条文；写进了没定义的键报 contract.unknown-key"
    },
    {
      "code": "contract.delivery-mismatch",
      "meaning": "交付核对或文件摘要不符"
    },
    {
      "code": "contract.immutable-key",
      "meaning": "改了创建之后不得改的键"
    },
    {
      "code": "contract.order-cycle",
      "meaning": "卡的先后要求排不出次序：成环，或提到了镜头里没有的卡"
    },
    {
      "code": "contract.output-conflict",
      "meaning": "开着原生运动模糊时要了和它冲突的输出"
    },
    {
      "code": "contract.patch-not-applicable",
      "meaning": "补丁里有一个操作不可作用"
    },
    {
      "code": "contract.runtime-shadows-param",
      "meaning": "ctx.cards.use 的 runtime 里有键和这张卡声明的参数同名"
    },
    {
      "code": "contract.shutter-conflict",
      "meaning": "快门角是 0 而子帧采样数大于 1"
    },
    {
      "code": "contract.undeclared-card",
      "meaning": "ctx.cards.use 用了这个镜头的 cards 里没声明过的实例名"
    },
    {
      "code": "contract.unknown-key",
      "meaning": "出现了契约没定义的键"
    },
    {
      "code": "contract.unknown-node",
      "meaning": "场景包里出现了节点登记表之外的图案节点"
    },
    {
      "code": "contract.unsupported-input",
      "meaning": "镜头输入里有帧源装不了的卡、资产或叠加层"
    },
    {
      "code": "contract.unsupported-mode",
      "meaning": "镜头条目的宿主或作者模式不在帧源的能力声明里"
    },
    {
      "code": "contract.unsupported-object",
      "meaning": "场景里有对象放不进这次要的某个输出"
    },
    {
      "code": "contract.unsupported-option",
      "meaning": "RenderOpts 给了帧源交不出的每像素采样数或缩放"
    },
    {
      "code": "contract.unsupported-output",
      "meaning": "要了帧源没声明过的输出"
    },
    {
      "code": "contract.unsupported-query",
      "meaning": "问了帧源没声明过的场景查询种类"
    },
    {
      "code": "env.ffmpeg-missing",
      "meaning": "找不到 FFmpeg 可执行文件"
    },
    {
      "code": "env.lock-required",
      "meaning": "没有锁文件，镜头却要用只有锁文件里才有的东西"
    },
    {
      "code": "failure.ffmpeg",
      "meaning": "FFmpeg 进程执行失败"
    },
    {
      "code": "timeout.ffmpeg",
      "meaning": "FFmpeg 进程超过调用时限"
    },
    {
      "code": "usage.bad-argument",
      "meaning": "调用的参数出了值域"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lock/lock-check.schema.json",
  "title": "锁核对记录",
  "description": "只管结构。各段对不对由 LK1 到 LK12 管，所以这里不收紧。",
  "type": "object",
  "required": ["format", "lock"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "lock-check/0.1" },
    "lock": { "$ref": "lock.schema.json" },
    "film": { "$ref": "../film/film.schema.json" },
    "renders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["renderer", "host", "version"],
        "additionalProperties": false,
        "properties": {
          "renderer": { "type": "string", "pattern": "^(blender|three|core|legacy-page|ext\\.[a-z0-9][a-z0-9-]*)$" },
          "host": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ext": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z0-9_.-]+$" } }
  }
}

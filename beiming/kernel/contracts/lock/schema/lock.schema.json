{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lock/lock.schema.json",
  "title": "锁文件",
  "description": "只管结构。和片子描述、元数据对不对得上由 LK1 到 LK9 管。seeds 必须有 film 这个键，别的键是镜头的 id。",
  "type": "object",
  "required": ["format", "film", "rev", "contracts", "seeds", "sources", "cards", "assets", "templates", "view", "machine"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "lock/1.0" },
    "film": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "rev": { "type": "integer", "minimum": 0 },
    "contracts": { "$ref": "#/$defs/version3" },
    "seeds": {
      "type": "object",
      "required": ["film"],
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^(blender|three|core|legacy-page|ext\\.[a-z0-9-]+)$" },
      "additionalProperties": {
        "type": "object",
        "required": ["version", "host", "image"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "minLength": 1 },
          "host": { "type": "string", "minLength": 1 },
          "image": { "$ref": "#/$defs/hash" },
          "browser": { "type": "string", "minLength": 1 },
          "scenePacks": {
            "type": "object",
            "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "additionalProperties": { "$ref": "#/$defs/hash" }
          }
        }
      }
    },
    "cards": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["version", "impl", "sha256", "verified"],
        "additionalProperties": false,
        "properties": {
          "version": { "$ref": "#/$defs/version3" },
          "impl": { "type": "string", "pattern": "^(blender|three|core|legacy-page|ext\\.[a-z0-9-]+|comp|kernel/eval)$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "from": { "enum": ["style.view", "style.finish", "delivery", "audio"] },
          "verified": {
            "type": "object",
            "required": ["level", "host", "source", "gpu"],
            "additionalProperties": false,
            "properties": {
              "level": { "enum": ["read", "reproduced", "measured", "film-verified"] },
              "host": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "gpu": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^asset:[a-z0-9][a-z0-9-]*@[1-9][0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/hash" }
    },
    "templates": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/version3" }
    },
    "view": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/hash" }
    },
    "machine": {
      "type": "object",
      "required": ["class", "driver"],
      "additionalProperties": false,
      "properties": {
        "class": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "driver": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "version3": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta/meta-check.schema.json",
  "title": "元数据核对记录",
  "description": "只管结构。metas、metaBytes 的取值由 M1、M3 管，两个颜色哈希相不相等由 M1 管，call 不重复由 M9 管，帧号对不对得上由 M11 管，所以这里不收紧。从交回的元数据里读的三个字段：metas 是 0 时不得出现，不是 0 时 metaFrame、metaShotFrame 必填。",
  "type": "object",
  "required": ["format", "shot", "start", "renders"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "meta-check/0.1" },
    "shot": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": { "const": "film" } },
    "start": { "type": "integer", "minimum": 0 },
    "renders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["call", "shotFrame", "metas", "metaBytes"],
        "additionalProperties": false,
        "properties": {
          "call": { "type": "integer", "minimum": 0 },
          "shotFrame": { "type": "integer", "minimum": 0 },
          "metas": { "type": "integer", "minimum": 0 },
          "metaBytes": { "type": "integer", "minimum": 0 },
          "metaFrame": { "type": "integer", "minimum": 0 },
          "metaShotFrame": { "type": "integer", "minimum": 0 },
          "colorFileSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "metaHashColor": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "if": { "properties": { "metas": { "const": 0 } } },
        "then": { "properties": { "metaFrame": false, "metaShotFrame": false, "metaHashColor": false } },
        "else": { "required": ["metaFrame", "metaShotFrame"] }
      }
    },
    "ext": { "type": "object" }
  }
}

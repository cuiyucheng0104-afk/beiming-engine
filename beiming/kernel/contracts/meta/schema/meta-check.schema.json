{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta/meta-check.schema.json",
  "title": "元数据核对记录",
  "description": "只管结构。metas、colorCall、metaBytes 的取值由 M1、M3 管，所以这里不收紧。",
  "type": "object",
  "required": ["format", "shot", "renders"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "meta-check/0.1" },
    "shot": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "renders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["call", "shotFrame", "metas", "metaBytes"],
        "additionalProperties": false,
        "properties": {
          "call": { "type": "integer", "minimum": 0 },
          "shotFrame": { "type": "integer", "minimum": 0 },
          "metas": { "type": "integer", "minimum": 0 },
          "metaBytes": { "type": "integer", "minimum": 0 },
          "colorCall": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "ext": { "type": "object" }
  }
}

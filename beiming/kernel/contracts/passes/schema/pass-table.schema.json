{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "passes/pass-table.schema.json",
  "title": "通道声明",
  "description": "只管结构。含哪些通道由 PS1 管，每个通道的属性取什么值由 PS2 管，所以这里不收紧。",
  "type": "object",
  "required": ["format", "channels"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "passes/0.1" },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "components", "colorSpace", "sample", "antialiased"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["f32", "u32"] }
              }
            }
          },
          "colorSpace": { "enum": ["scene-linear-rec709", "none"] },
          "sample": { "enum": ["accumulate", "first-sample"] },
          "antialiased": { "type": "boolean" }
        }
      }
    },
    "ext": { "type": "object" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "film/explain.schema.json",
  "title": "Explain",
  "description": "只管结构。层的次序和最终值由 D9 管。value 是任意 JSON 值，但不得是 null。",
  "type": "object",
  "required": ["path", "value", "unit", "layers", "affects"],
  "additionalProperties": false,
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "value": { "not": { "type": "null" } },
    "unit": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "from"],
        "additionalProperties": false,
        "properties": {
          "layer": { "enum": ["card-default", "template", "film", "job"] },
          "from": { "type": "string", "minLength": 1 },
          "value": { "not": { "type": "null" } }
        }
      }
    },
    "coupling": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "affects": {
      "type": "object",
      "required": ["shots", "frames"],
      "additionalProperties": false,
      "properties": {
        "shots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "frames": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}

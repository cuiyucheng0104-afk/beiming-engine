{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patch/patch.schema.json",
  "title": "补丁",
  "description": "只管结构。哪种操作带 value、带 to 由 PA1 管，这里不收紧。",
  "type": "object",
  "required": [
    "format",
    "rev",
    "ops"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "patch/0.1"
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "op",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "op": {
            "enum": [
              "set",
              "remove",
              "rename",
              "add"
            ]
          },
          "path": {
            "type": "string",
            "description": "写法见片子描述契约 5.4；是字符串就过结构定义，写得对不对（含空串）由错误码表契约 5.6 第 4 步判"
          },
          "value": {},
          "to": {
            "type": "string",
            "pattern": "^[^/#\\s]+$"
          }
        }
      }
    }
  }
}

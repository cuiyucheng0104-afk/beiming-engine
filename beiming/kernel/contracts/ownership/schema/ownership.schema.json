{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ownership/ownership.schema.json",
  "title": "目录归属表",
  "description": "只管结构。path 重不重复、必有的条目、三条放置规则、工作包的写入范围重不重叠由 OW1 到 OW4 管。",
  "type": "object",
  "required": [
    "format",
    "root",
    "entries",
    "placements"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ownership/0.1"
    },
    "root": {
      "const": "beiming"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "owner",
          "holds"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(\\.|[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*)$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "holds": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "where"
        ],
        "additionalProperties": false,
        "properties": {
          "what": {
            "enum": [
              "card-file",
              "builtin-impl",
              "data-card-impl"
            ]
          },
          "where": {
            "type": "string",
            "pattern": "^[a-z<][a-z0-9<>-]*(/[a-z<][a-z0-9<>-]*)*$"
          },
          "covers": {
            "type": "array",
            "items": {
              "enum": [
                "timeline",
                "events",
                "rng",
                "interp"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "writes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*(-[A-Za-z0-9]+)*$"
          },
          "writes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(/[A-Za-z0-9._-]+)*$"
            }
          }
        }
      }
    },
    "ext": {
      "type": "object"
    }
  }
}

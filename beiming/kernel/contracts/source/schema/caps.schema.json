{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source/caps.schema.json",
  "title": "能力声明 Caps",
  "description": "只管结构。id 和 conformance 的搭配由 F10 管、落没落在帧源登记表之内由 F15 管，所以这里不收紧。",
  "type": "object",
  "required": ["format", "id", "version", "language", "hosts", "conformance", "outputs", "sceneQuery", "motionBlur", "determinism", "draft", "final", "granularity", "randomAccess", "modes", "cost"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "caps/0.1" },
    "id": { "type": "string", "pattern": "^(blender|three|core|legacy-page|ext\\.[a-z0-9][a-z0-9-]*)$" },
    "version": { "type": "string", "minLength": 1 },
    "language": { "enum": ["python", "js", "wgsl"] },
    "hosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "conformance": { "enum": ["full", "limited"] },
    "outputs": {
      "type": "object",
      "description": "六个键必填。别的键只收 PS 3.1 的固定通道名和 lightgroup:*；名字在不在 PS 的登记表里由条文管，这里只管写法。",
      "required": ["color", "meta", "depth", "objectId", "normal", "motion"],
      "additionalProperties": false,
      "patternProperties": {
        "^(?!(color|meta)$)[a-z][A-Za-z0-9]*$": { "$ref": "#/$defs/pixelOutput" },
        "^lightgroup:\\*$": { "$ref": "#/$defs/pixelOutput" }
      },
      "properties": {
        "color": {
          "type": "object",
          "required": ["type", "transfer", "primaries"],
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/$defs/sampleType" },
            "transfer": { "const": "linear" },
            "primaries": { "const": "rec709" },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "meta": { "type": "boolean" }
      }
    },
    "sceneQuery": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/queryKind" } },
    "motionBlur": {
      "type": "object",
      "required": ["mode", "auxAt"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["native", "accumulate"] },
        "auxAt": { "const": "sub0" },
        "samples": { "type": "integer", "minimum": 1 },
        "conflicts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/outputName" } }
      },
      "if": { "properties": { "mode": { "const": "accumulate" } } },
      "then": { "required": ["samples"] }
    },
    "determinism": { "enum": ["hash-same-machine", "tolerance"] },
    "draft": {
      "type": "object",
      "required": ["kind", "samples", "scale"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["cycles-low", "scale", "path-low"] },
        "samples": { "type": "integer", "minimum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "denoise": { "type": "string", "minLength": 1 }
      }
    },
    "final": {
      "type": "object",
      "required": ["samples", "scale"],
      "additionalProperties": false,
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "denoise": { "type": "string", "minLength": 1 }
      }
    },
    "granularity": { "const": "frame" },
    "randomAccess": { "type": "boolean" },
    "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["cards-data", "build-script", "native-code"] } },
    "cost": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": { "unit": { "const": "gpu-second" } }
    },
    "input": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[0-9]+\\.[0-9]+$" },
    "solvers": { "type": "array", "uniqueItems": true, "items": { "enum": ["path"] } },
    "channels": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[0-9]+\\.[0-9]+$" },
    "metaNull": { "type": "array", "uniqueItems": true, "items": { "enum": ["stats.noise", "stats.tris", "texts", "lights"] } },
    "ext": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z0-9_.-]+$" } }
  },
  "$defs": {
    "outputName": {
      "description": "meta，或 PS 3.1 的通道名（含 lightgroup:<名>）。名字在不在 PS 的登记表里由条文管，这里只管写法。",
      "type": "string",
      "pattern": "^([a-z][A-Za-z0-9]*|lightgroup:[a-z0-9][a-z0-9-]*)$"
    },
    "queryKind": { "enum": ["bbox3d", "anchor", "intersect", "contact", "belowGround"] },
    "sampleType": { "description": "层文件里的数值类型，不是渲染时的精度。", "enum": ["f32", "u32"] },
    "pixelOutput": {
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/$defs/sampleType" },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}

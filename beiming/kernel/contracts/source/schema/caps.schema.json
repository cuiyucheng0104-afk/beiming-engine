{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source/caps.schema.json",
  "title": "能力声明 Caps",
  "description": "只管结构。id 和 conformance 的搭配由 F10 管，所以这里不收紧。",
  "type": "object",
  "required": ["format", "id", "version", "language", "hosts", "conformance", "outputs", "sceneQuery", "motionBlur", "determinism", "draft", "granularity", "randomAccess", "modes", "cost"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "caps/0.1" },
    "id": { "type": "string", "pattern": "^(blender|three|core|legacy-page|ext\\.[a-z0-9][a-z0-9-]*)$" },
    "version": { "type": "string", "minLength": 1 },
    "language": { "enum": ["python", "js", "wgsl"] },
    "hosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "conformance": { "enum": ["full", "limited"] },
    "outputs": {
      "type": "object",
      "required": ["color", "meta", "depth", "objectId", "normal", "motion"],
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "object",
          "required": ["type", "transfer", "primaries"],
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/$defs/sampleType" },
            "transfer": { "const": "linear" },
            "primaries": { "const": "rec709" },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "meta": { "type": "boolean" },
        "depth": { "$ref": "#/$defs/pixelOutput" },
        "objectId": { "$ref": "#/$defs/pixelOutput" },
        "normal": { "$ref": "#/$defs/pixelOutput" },
        "motion": { "$ref": "#/$defs/pixelOutput" }
      }
    },
    "sceneQuery": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/queryKind" } },
    "motionBlur": {
      "type": "object",
      "required": ["mode", "auxAt"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["native", "accumulate"] },
        "auxAt": { "enum": ["sub0", "first-sample"] },
        "conflicts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/outputName" } }
      }
    },
    "determinism": { "enum": ["hash-same-machine", "tolerance"] },
    "draft": {
      "type": "object",
      "required": ["kind", "samples", "scale"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["cycles-low", "scale", "path-low"] },
        "samples": { "type": "integer", "minimum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "denoise": { "type": "string", "minLength": 1 }
      }
    },
    "granularity": { "const": "frame" },
    "randomAccess": { "type": "boolean" },
    "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["cards-data", "build-script", "native-code"] } },
    "cost": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": { "unit": { "const": "gpu-second" } }
    },
    "input": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[0-9]+\\.[0-9]+$" },
    "solvers": { "type": "array", "uniqueItems": true, "items": { "enum": ["path"] } },
    "channels": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[0-9]+\\.[0-9]+$" },
    "metaNull": { "type": "array", "uniqueItems": true, "items": { "enum": ["camera.focusDist", "camera.fstop", "stats.noise", "lights"] } },
    "ext": { "type": "object" }
  },
  "$defs": {
    "outputName": { "enum": ["color", "meta", "depth", "objectId", "normal", "motion"] },
    "queryKind": { "enum": ["bbox3d", "anchor", "intersect", "contact", "belowGround"] },
    "sampleType": { "enum": ["half", "f32", "u32"] },
    "pixelOutput": {
      "oneOf": [
        { "const": false },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "$ref": "#/$defs/sampleType" },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}

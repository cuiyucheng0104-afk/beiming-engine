{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predicates/predicates.schema.json",
  "title": "谓词登记表",
  "description": "只管结构。四项齐不齐以条文 PR2 为准，所以 params、reads、requires、since 这里不写进 required；名字重不重复、模板用到的名字、最低谓词的内容由 PR1 到 PR6 管。",
  "type": "object",
  "required": [
    "format",
    "predicates",
    "templates"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "predicates/0.1"
    },
    "predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "type": {
                  "oneOf": [
                    {
                      "enum": [
                        "entity",
                        "number",
                        "frame",
                        "text",
                        "ref"
                      ]
                    },
                    {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "enum": [
                          "entity",
                          "number",
                          "frame",
                          "text",
                          "ref"
                        ]
                      },
                      "uniqueItems": true
                    }
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "reads": {
            "type": "array",
            "items": {
              "enum": [
                "film",
                "film-audio",
                "film-ocr",
                "audio",
                "events",
                "tracks",
                "render-stats",
                "query",
                "meta.size",
                "meta.camera",
                "meta.lights",
                "meta.texts",
                "meta.stats",
                "meta.entities.bbox2d",
                "meta.entities.visible",
                "meta.entities.pxArea",
                "meta.entities.depth",
                "meta.entities.motion"
              ]
            },
            "uniqueItems": true
          },
          "requires": {
            "type": "array",
            "items": {
              "enum": [
                "meta",
                "objectId",
                "texts",
                "intersect",
                "contact"
              ]
            },
            "uniqueItems": true
          },
          "requiresPerEntity": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "meta",
                "objectId",
                "texts",
                "intersect",
                "contact"
              ]
            },
            "uniqueItems": true
          },
          "only": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(blender|three|core|legacy-page|ext\\.[a-z0-9-]+)$"
            },
            "uniqueItems": true
          },
          "since": {
            "enum": [
              "0.1",
              "planned"
            ]
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "roles",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "hero",
                "mustSee"
              ]
            },
            "uniqueItems": true
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "expr",
                "uses",
                "limited"
              ],
              "additionalProperties": false,
              "properties": {
                "expr": {
                  "type": "string",
                  "minLength": 1
                },
                "uses": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)*$"
                  },
                  "uniqueItems": true
                },
                "limited": {
                  "type": "boolean"
                },
                "when": {
                  "enum": [
                    "has-audio",
                    "has-text"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "ext": {
      "type": "object"
    }
  }
}

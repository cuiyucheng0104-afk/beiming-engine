  "calibration": "probe-gray-chart",
  "verify": {
    "selftest": "验证 ACES 拟合单调有界、阴影偏冷高光偏暖分离色调、暗角四角衰减、径向色差分离、Bloom/Shaft/Flash 合成、fade=0 归黑，以及 CPU 与 WebGL2 着色器同输入误差 <= 1/255",
    "predicates": []
  },
  "pitfalls": [
    {
      "symptom": "CPU 与 WebGL2 核验出现上下翻转",
      "fix": "EXR/PNG 自顶向下缓冲使用默认 origin='top-left'，WebGL readPixels 自底向上缓冲传 origin='bottom-left'"
    },
    {
      "symptom": "ACES 矩阵转置导致色彩发绿或发紫",
      "fix": "GLSL mat3 按列主序构造，CPU 矩阵乘法须与 GLSL 列向量右乘一致"
    }
  ],
  "provenance": {

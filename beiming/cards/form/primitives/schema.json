{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,40}$"
        },
        "center": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          }
        },
        "kind": {
          "const": "box"
        },
        "sizeM": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 1e-05,
            "maximum": 1000
          }
        },
        "bevelM": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "bevelSegments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "kind",
        "sizeM"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,40}$"
        },
        "center": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          }
        },
        "kind": {
          "const": "cylinder"
        },
        "radiusM": {
          "type": "number",
          "minimum": 1e-05,
          "maximum": 1000
        },
        "heightM": {
          "type": "number",
          "minimum": 1e-05,
          "maximum": 1000
        },
        "segments": {
          "type": "integer",
          "minimum": 4,
          "maximum": 256
        },
        "bevelM": {
          "type": "number",
          "minimum": 0,
          "maximum": 500
        },
        "bevelSegments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "kind",
        "radiusM",
        "heightM"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,40}$"
        },
        "center": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          }
        },
        "kind": {
          "const": "slotted_plate"
        },
        "sizeM": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 1e-05,
            "maximum": 1000
          }
        },
        "slotSizeM": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 1e-05,
            "maximum": 1000
          }
        },
        "slotDepthM": {
          "type": "number",
          "minimum": 1e-05,
          "maximum": 1000
        }
      },
      "required": [
        "kind",
        "sizeM",
        "slotSizeM",
        "slotDepthM"
      ]
    }
  ]
}

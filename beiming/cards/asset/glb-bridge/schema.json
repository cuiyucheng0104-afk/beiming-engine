{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cards/asset/glb-bridge/schema.json",
  "title": "GLB 资产零件桥规格与二进制载荷",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "string",
      "minLength": 4
    },
    {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["expectedParts"] },
        { "required": ["parts"] },
        { "required": ["glb"] },
        { "required": ["glbBase64"] }
      ],
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "expectedParts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "upAxis": {
          "type": "string",
          "enum": [
            "Y",
            "Z"
          ]
        },
        "unitScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "glb": {},
        "glbBase64": {
          "type": "string",
          "minLength": 4
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.]+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "mesh",
                  "group"
                ]
              },
              "parent": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.]+$"
              },
              "translation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "scale": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "bbox": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "number"
                }
              },
              "positions": {
                "type": "array",
                "minItems": 9,
                "items": {
                  "type": "number"
                }
              },
              "normals": {
                "type": "array",
                "minItems": 9,
                "items": {
                  "type": "number"
                }
              },
              "uvs": {
                "type": "array",
                "minItems": 6,
                "items": {
                  "type": "number"
                }
              },
              "indices": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "material": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "baseColorFactor": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "metallicFactor": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "roughnessFactor": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["asset"],
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "object"
        },
        "scene": {
          "type": "integer",
          "minimum": 0
        },
        "scenes": {
          "type": "array"
        },
        "nodes": {
          "type": "array"
        },
        "meshes": {
          "type": "array"
        },
        "materials": {
          "type": "array"
        },
        "accessors": {
          "type": "array"
        },
        "bufferViews": {
          "type": "array"
        },
        "buffers": {
          "type": "array"
        }
      }
    }
  ]
}

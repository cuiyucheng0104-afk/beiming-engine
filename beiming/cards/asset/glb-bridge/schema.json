{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cards/asset/glb-bridge/schema.json",
  "title": "GLB 资产零件桥规格",
  "type": "object",
  "required": [
    "expectedParts"
  ],
  "additionalProperties": false,
  "properties": {
    "alias": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "expectedParts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "upAxis": {
      "type": "string",
      "enum": [
        "Y",
        "Z"
      ]
    },
    "unitScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mesh",
              "group"
            ]
          },
          "parent": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]+$"
          },
          "translation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rotation": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "scale": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "bbox": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}

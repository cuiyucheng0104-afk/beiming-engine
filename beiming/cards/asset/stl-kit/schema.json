{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cards/asset/stl-kit/schema.json",
  "title": "STL 套件与北冥坐标代理尺寸",
  "type": "object",
  "required": ["parts"],
  "additionalProperties": false,
  "properties": {
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "anyOf": [{ "required": ["path"] }, { "required": ["bytes"] }, { "required": ["fallbackBbox"] }, { "required": ["size"] }],
        "allOf": [
          { "not": { "required": ["path", "bytes"] } },
          { "not": { "required": ["fallbackBbox", "size"] } }
        ],
        "dependentRequired": { "center": ["size"] },
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*(?![\\s\\S])" },
          "path": { "type": "string", "pattern": "\\S", "not": { "pattern": "\\u0000" } },
          "bytes": {
            "oneOf": [
              { "type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])" },
              { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
            ]
          },
          "fallbackBbox": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } },
          "size": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } },
          "center": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
        }
      }
    }
  }
}

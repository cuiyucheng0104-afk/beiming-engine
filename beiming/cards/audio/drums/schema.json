{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cards/audio/drums/schema.json",
  "title": "程序化鼓组节拍与事件规格",
  "type": "object",
  "required": [
    "hits"
  ],
  "additionalProperties": false,
  "properties": {
    "bpm": {
      "type": "number",
      "minimum": 20,
      "maximum": 300
    },
    "stepsPerBeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "hits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "voice",
          "frame"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "voice": {
            "type": "string",
            "enum": [
              "kick",
              "snare",
              "hihat",
              "rim",
              "accent"
            ]
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "sub": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1
          },
          "velocity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    }
  }
}

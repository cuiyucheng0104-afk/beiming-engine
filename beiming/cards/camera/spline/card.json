{
  "format": "card/0.1",
  "id": "camera.spline",
  "version": "1.0.0",
  "kind": "camera",
  "title": "样条运镜",
  "intent": "让相机沿几个关键位置之间的光滑曲线走，始终看向给定的点或实体",
  "visibleToAgent": true,
  "livesIn": [
    "data"
  ],
  "impl": [
    {
      "livesIn": "data",
      "entry": "cards/camera/spline/evaluate.mjs",
      "shape": "evaluate",
      "hosts": [],
      "selftest": "cards/camera/spline/selftest.test.mjs"
    }
  ],
  "params": {
    "keys": {
      "type": "data",
      "unit": "none",
      "schema": "keys.schema.json",
      "default": [
        {
          "f": 0,
          "pos": [
            0,
            0,
            1
          ],
          "look": [
            0,
            0,
            0
          ]
        }
      ],
      "coupling": "scene-scale"
    },
    "fovDeg": {
      "type": "number",
      "unit": "deg",
      "range": [
        1,
        170
      ],
      "default": 40,
      "coupling": "none"
    }
  },
  "ports": {
    "in": [
      {
        "name": "bbox",
        "type": "bbox-world"
      }
    ],
    "out": [
      {
        "name": "camera",
        "type": "tracks.camera"
      }
    ],
    "order": {
      "before": [],
      "after": []
    },
    "requires": [
      "look 写实体名时，求值核要把这个实体逐帧的世界包围盒交进 inputs.bbox"
    ]
  },
  "conditions": {
    "appliesWhen": [
      "推、拉、摇、绕这类位置写得出关键帧的运镜"
    ],
    "notWhen": [
      "要按主体的大小自动取景",
      "相机要过看向点的正上方或正下方：这时朝向定不出来，卡会报错"
    ]
  },
  "calibration": "probe-axes-turntable",
  "verify": {
    "selftest": "两个关键帧之间位置是直线；过三个关键帧时每个关键帧上位置正好是写的那个点；相机的 −Z 轴指向看向点，Y 轴朝上；视场角在关键帧之间线性过渡",
    "predicates": []
  },
  "pitfalls": [
    {
      "symptom": "镜头开头或结尾相机不动",
      "fix": "第一个关键帧之前、最后一个之后保持不动；把首尾关键帧放到镜头的两端"
    },
    {
      "symptom": "过关键帧时速度有变化",
      "fix": "切线按相邻关键帧的位置差除以帧数差取；关键帧间隔差得多时把间隔调匀"
    }
  ],
  "provenance": {
    "cases": [],
    "note": "位置用三次埃尔米特样条（切线取相邻关键帧的差商），朝向每个时刻由位置和看向点现算"
  },
  "status": [
    {
      "level": "reproduced",
      "host": "kernel-eval",
      "source": "0.1.0",
      "gpu": "none",
      "date": "2026-11-21"
    }
  ],
  "exams": [
    "cal:camera.spline"
  ]
}

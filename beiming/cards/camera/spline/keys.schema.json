{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "camera.spline 的关键帧",
  "description": "按 f 从小到大写，f 不得重复。pos 和 look 的坐标是世界坐标，米，右手系，Y 向上。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["f", "pos", "look"],
    "additionalProperties": false,
    "properties": {
      "f": { "type": "integer", "minimum": 0, "description": "镜头局部帧号" },
      "pos": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" }, "description": "相机位置，米" },
      "look": {
        "description": "看向哪：世界坐标里的一个点（米），或者一个实体名（看它包围盒的中心）",
        "oneOf": [
          { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
          { "type": "string", "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$" }
        ]
      },
      "fovDeg": { "type": "number", "minimum": 1, "maximum": 170, "description": "竖直视场角，度；不写用卡的 fovDeg 参数" }
    }
  }
}

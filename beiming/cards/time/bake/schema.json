{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["durationS", "sampleHz", "tracks"],
  "properties": {
    "durationS": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
    "sampleHz": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
    "substeps": { "type": "integer", "minimum": 1, "maximum": 64 },
    "warmupSteps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "interpolation": { "enum": ["nearest", "linear", "cubic"] },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lengthM"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "lengthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
          "drag": { "type": "number", "minimum": 0, "maximum": 10 },
          "damping": { "type": "number", "minimum": 0, "maximum": 50 },
          "windBase": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "gustAmp": { "type": "number", "minimum": 0, "maximum": 200 },
          "gustTimeS": { "type": "number", "minimum": 0, "maximum": 3600 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["wavelength", "slip", "idleSpeed"],
  "properties": {
    "wavelength": { "type": "number", "exclusiveMinimum": 0 },
    "slip": { "type": "number", "minimum": 0 },
    "idleSpeed": { "type": "number", "minimum": 0 },
    "ampSlow": { "type": "number", "minimum": 0 },
    "ampFast": { "type": "number", "minimum": 0 },
    "speedSlow": { "type": "number", "minimum": 0 },
    "speedFast": { "type": "number", "minimum": 0 },
    "heaveRatio": { "type": "number", "minimum": 0 },
    "heaveFreqRatio": { "type": "number", "exclusiveMinimum": 0 },
    "heavePhaseDeg": { "type": "number" },
    "headFade": { "$ref": "#/$defs/pair" },
    "tailBoostStart": { "type": "number", "minimum": 0 },
    "tailBoostBase": { "type": "number", "minimum": 0 },
    "tailBoostGain": { "type": "number", "minimum": 0 },
    "verticalFade": { "$ref": "#/$defs/pair" },
    "stirWavelength": { "type": "number", "exclusiveMinimum": 0 },
    "stirSpeed": { "type": "number", "minimum": 0 },
    "stirSideAmp": { "type": "number", "minimum": 0 },
    "stirHeaveAmp": { "type": "number", "minimum": 0 },
    "stirHeadFade": { "$ref": "#/$defs/pair" },
    "stirTailFadeFrac": { "$ref": "#/$defs/pair" }
  }
}

      "侧摆在水平正交轴、起伏在切线与侧摆正交轴上施加，近竖直切线平滑淡出"
    ]
  },
  "conditions": {
    "appliesWhen": [
      "细长躯干沿轨道滑行时需要自然的行波侧摆与法向起伏"
    ],
    "notWhen": [
      "刚性体不允许产生沿弧长形变"
    ]
  },
  "calibration": "probe-moving-cube",
  "verify": {
    "selftest": "核对 amplitude=0 精确归零、行波尾向传播相位、头尾包络与正交性、近竖直淡出及乱序抽帧一致。",
    "predicates": []
  },
  "pitfalls": [
    {
      "symptom": "垂直爬升或俯冲时脊线水平面侧摆跳变",
      "fix": "保持 verticalFade 在水平分量过小时平滑归零，不要将下限设为 0。"
    },
    {
      "symptom": "头部出现不希望的左右晃动",
      "fix": "将 headFade 起点设在大于 0 的弧长，确保头部保持在轨道中心。"
    }
  ],

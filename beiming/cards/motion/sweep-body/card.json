      "before": [],
      "after": ["motion.impulse", "motion.swim", "motion.roll-bank"]
    },
    "requires": [
      "轨道可由三维控制点经向心 Catmull-Rom 自动弧长重采样，或直接给出等弧长采样点列",
      "输出逐弧长节点 { pos, tan, nor, bin, s }，所有标架均为右手正交单位基，任意顺序抽帧逐位一致"
    ]
  },
  "conditions": {
    "appliesWhen": [
      "细长柔性躯干沿三维轨道前行，需要组合行波侧摆、推力脉冲与平行输运翻滚倾斜标架"
    ],
    "notWhen": [

    ]
  },
  "calibration": "probe-moving-cube",
  "verify": {
    "selftest": "核对单调三次弧长映射、向心样条求值、正交单位标架、相邻扭转跳变限幅、乱序抽帧逐位一致及脉冲/游动波开关。",
    "predicates": []
  },
  "pitfalls": [
    {
      "symptom": "头部经过相邻控制点时出现忽快忽慢或倒退",
      "fix": "使用单调三次插值 timeKeys，并保证时间序列严格递增、弧长非递减。"
    },
    {
      "symptom": "长镜头逐帧求值开销偏高",
      "fix": "先调用 compileRail 预编译不可变轨道表，再在 ctx.compiledRail 传入各帧求值。"
    }
  ],

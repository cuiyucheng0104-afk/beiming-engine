{
  "route": "b",
  "title": "{{TITLE}}",
  "dur": 4.5,
  "fps": 24,
  "size": [1920, 1080],
  "events": [
    { "id": "title", "frame": 16, "visual": "片名第一个字落定", "audio": "玻璃铃" }
  ],
  "native": {
    "entry": "film.tsx",
    "images": [
      { "to": "backdrop.png", "from": "../../assets/plates/sky_dawn.png" },
      { "to": "mist.png", "from": "../../assets/plates/mist_low.png", "edge": { "left": 0.16, "right": 0.16, "jitter": 0.7, "lobes": 3, "seed": 2 } },
      { "to": "paper.png", "from": "../../assets/plates/paper.png" }
    ],
    "models": [
      {
        "to": "prop.glb", "module": "prop.js", "export": "createProp", "length": 1.6, "prefix": "prop",
        "args": { "period": 3, "colors": { "body": "#E8D9C4", "band": "#C8463C", "cap": "#2A2D52", "lamp": "#FFD9A0" } },
        "clip": { "name": "Idle", "pose": "pose", "duration": 3, "fps": 24, "loop": true },
        "meta": { "forward": "+X", "up": "+Y" },
        "validate": { "animated": true, "clip": "Idle", "duration": 3, "nodes": ["prop-float", "prop-vane"] }
      }
    ],
    "sequences": [],
    "audio": { "script": "sound.py", "out": "mix.wav" }
  }
}

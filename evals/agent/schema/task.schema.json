{
  "$comment": "evals/agent/tasks/<ID>.json 的格式。只用 tools/eval/lib/schema.mjs 支持的关键字。",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "title", "prompt", "environment", "timeboxMinutes", "attempts", "writeScope", "rules", "gates", "hardGates", "scoring"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^(DF-[A-Z]|S[0-9]|DR-[A-Z])$" },
    "kind": { "enum": ["film", "safety", "drill"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "route": { "type": ["string", "null"], "enum": ["a", "b", "c", null] },
    "filmId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "prompt": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.md$" },
    "context": { "type": ["string", "null"] },
    "environment": { "enum": ["cold", "prepared"] },
    "requiresEnv": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
    "isolation": { "type": "array", "items": { "enum": ["isolated", "user-env"] }, "minItems": 1, "uniqueItems": true },
    "timeboxMinutes": { "type": "integer", "minimum": 5, "maximum": 600 },
    "attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "spec": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["profile", "width", "height", "fps", "frameCount"],
          "additionalProperties": false,
          "properties": {
            "profile": { "type": "string" },
            "width": { "type": "integer", "minimum": 16 },
            "height": { "type": "integer", "minimum": 16 },
            "fps": { "type": "integer", "minimum": 1 },
            "frameCount": { "type": "integer", "minimum": 1 },
            "shots": { "type": "integer", "minimum": 1 },
            "cuts": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
            "audio": { "type": "boolean" },
            "beatEvents": { "type": "integer", "minimum": 1 },
            "titleHoldSeconds": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "writeScope": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^films/([a-z0-9][a-z0-9-]*/)?$" } },
    "newFilmDirsOnly": { "type": "boolean" },
    "seed": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commands": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "generate"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string", "pattern": "^films/" },
                  "generate": { "enum": ["wav-tone", "text"] },
                  "seconds": { "type": "number", "minimum": 0.1, "maximum": 10 },
                  "text": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbiddenWritePrefixes": { "type": "array", "items": { "type": "string", "pattern": "^[^/].*/$" } },
        "forbiddenGit": { "type": "array", "items": { "enum": ["add-all", "commit", "push"] } },
        "forbiddenTools": { "type": "array", "items": { "type": "string" } },
        "forbiddenAccess": { "type": "array", "items": { "enum": ["home-lemo", "outside-skills"] } },
        "forbiddenRestore": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "$ref": "#/$defs/gateRule" } },
        "recommended": { "type": "array", "items": { "$ref": "#/$defs/gateRule" } },
        "forbidApprove": { "type": "array", "items": { "type": "string" } },
        "onlyIfRendered": { "type": "boolean" },
        "aliases": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "hardGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["H1", "H2", "H3", "H4", "H5", "H6", "H7"] } },
    "qa": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "properties": { "commands": { "type": "array", "minItems": 1, "items": { "enum": ["delivery", "visual", "texts", "plates"] } } } }
      ]
    },
    "runtime": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "required": ["version"], "additionalProperties": false, "properties": { "version": { "type": "string" }, "requireGraphicsBackend": { "type": "boolean" } } }
      ]
    },
    "partitions": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "directorOnly": { "type": "array", "items": { "type": "string" } },
            "roots": { "type": "array", "items": { "type": "string" } },
            "maxSubagents": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "safety": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["checks"],
          "additionalProperties": false,
          "properties": {
            "checks": { "type": "array", "minItems": 1, "items": { "enum": ["vendor-untouched", "alternative-or-films", "waiver-quotes-user", "no-false-claims", "staging-scope", "repo-skill-only", "casebook-check"] } },
            "criteria": { "type": "string" }
          }
        }
      ]
    },
    "scoring": {
      "type": "object",
      "required": ["process"],
      "additionalProperties": false,
      "properties": {
        "process": { "enum": ["solo", "orchestration", "none"] },
        "visualReference": { "type": ["string", "null"] },
        "styleReference": { "type": ["string", "null"] }
      }
    },
    "replies": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]+\\.json$" },
    "planRef": { "type": "string" }
  },
  "$defs": {
    "gateRule": {
      "type": "object",
      "required": ["gate", "accept"],
      "additionalProperties": false,
      "properties": {
        "gate": { "type": "string" },
        "accept": { "type": "array", "minItems": 1, "items": { "enum": ["approve", "waive"] } },
        "note": { "type": "string" }
      }
    }
  }
}

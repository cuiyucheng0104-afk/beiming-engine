{
  "schemaVersion": 2,
  "$comment": "交付档位（决策 D07、计划附录 C7）的唯一权威表。出片编排、渲染器与机器 QA 都读这一份：QA（tools/qa/lib/profiles.mjs）直接读它，tools/qa/profiles.builtin.json 只在这里缺档位或缺字段时兜底（兜底会在 QA 报告里标 warn，仓库检查 spec.profiles 要求零兜底）。每个档位完整展开、不做继承，方便机器逐项比对。字段写法与 QA 的 adapt 对齐：video.color.{range,matrix,primaries,transfer}、video.profiles、audio.loudness.{integrated,tolerance,truePeak}；safeArea、texts、visual、plates、sync、container、aigc 各段 QA 原样读取（含义与出处见 docs/quality/QA-GATE.md）。秒数阈值换成本片帧数由 engine/production/film.js 的 qaExpectations 完成；作品可在 film.json 的 qa 段按键覆盖。",
  "default": "web-1080p24",
  "ffprobeFields": {
    "video.codec": "codec_name",
    "video.profiles": "profile（取其一）",
    "video.pixFmt": "pix_fmt",
    "video.sar": "sample_aspect_ratio",
    "video.fieldOrder": "field_order",
    "video.color.range": "color_range",
    "video.color.matrix": "color_space",
    "video.color.primaries": "color_primaries",
    "video.color.transfer": "color_transfer",
    "video.width": "width",
    "video.height": "height",
    "video.fps": "r_frame_rate 与 avg_frame_rate（写成 <fps>/1）",
    "audio.codec": "codec_name",
    "audio.aacProfile": "profile",
    "audio.sampleRate": "sample_rate",
    "audio.channels": "channels",
    "audio.channelLayout": "channel_layout"
  },
  "profiles": {
    "web-1080p24": {
      "label": "网页 1080p24（新作品默认）",
      "role": "delivery",
      "purpose": "网页、社交平台、客户预览的默认成片",
      "source": "决策 D07（docs/decisions/2026-11-10-industrial-baseline.md）",
      "video": {
        "width": 1920,
        "height": 1080,
        "fps": 24,
        "cfr": true,
        "codec": "h264",
        "profiles": ["High"],
        "maxLevel": 4.1,
        "pixFmt": "yuv420p",
        "sar": "1:1",
        "fieldOrder": "progressive",
        "color": { "range": "tv", "matrix": "bt709", "primaries": "bt709", "transfer": "bt709" }
      },
      "audio": {
        "codec": "aac",
        "aacProfile": "LC",
        "sampleRate": 48000,
        "channels": 2,
        "channelLayout": "stereo",
        "loudness": { "integrated": -14, "tolerance": 1, "truePeak": -1, "measure": "最终 AAC 文件；ITU-R BS.1770 门限积分（ffmpeg ebur128）" }
      },
      "container": { "formats": ["mp4", "mov"], "faststart": "warn" },
      "safeArea": {
        "unit": "每边内缩占画面宽或高的比例",
        "title": { "top": 0.05, "right": 0.05, "bottom": 0.05, "left": 0.05 },
        "action": { "top": 0.035, "right": 0.035, "bottom": 0.035, "left": 0.035 },
        "source": "EBU R95：16:9 图文安全区 90%（每边 5%）、动作安全区 93%（每边 3.5%），与 routes/directing/VISUAL-DESIGN.md §6.3 一致"
      },
      "texts": {
        "minHoldSec": 0.8,
        "perUnitSec": 0.12,
        "opaqueAlpha": 0.9,
        "targetBaseSec": 1.5,
        "targetUnitsPerSec": 4.5,
        "minContrast": 3,
        "goodContrast": 4.5
      },
      "visual": {
        "blackPixel": 0.02,
        "blackRatio": 0.98,
        "freezeMinSec": 0.5,
        "freezeNoiseDb": -50,
        "flickerLevels": 6,
        "flickerHalfWindow": 5,
        "cutScore": 10,
        "cutTolFrames": 1,
        "cutNmsFrames": 2,
        "jumpRatio": 3,
        "jumpMinLevels": 2,
        "edgeBandMinPx": 4,
        "edgeLineMinFrac": 0.3,
        "flashLumDelta": 20,
        "flashMaxPerSec": 3,
        "flashAreaFrac": 0.25
      },
      "plates": { "sides": ["left", "right"], "maxStdPx": 15, "minCoverage": 0.3, "minOpacity": 0.05, "densityWarn": 1, "densityFail": 0.6 },
      "sync": { "earlyFrames": 0.25, "lateFrames": 1, "lipLateFrames": 2, "minRiseDb": 8, "searchEarlySec": 0.15, "searchLateSec": 0.25 },
      "aigc": { "metadata": "required" }
    },
